<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!--
  IDE-ONLY target platform: the full Eclipse SDK, for launching the plug-in as an
  Eclipse Application.

  The Maven build never sees this file. Tycho resolves the target artifact by module
  artifactId, so `parent/pom.xml`'s target-platform-configuration always picks the lean
  `targetplatform.target` sitting next to this one; a second .target in the module is
  ignored as long as one is named <artifactId>.target. CI therefore keeps building
  against the minimal bundle set, which is what the plug-in actually ships against.

  Use it when you want the runtime workbench to behave like a real IDE. The lean target
  resolves only the plug-in's Require-Bundle closure, so the launched Eclipse comes up
  with no CSS theme (`Theme 'org.eclipse.e4.ui.css.theme.e4_default' not found`), no
  macOS cocoa renderer fragment, and only the sliver of key bindings that
  org.eclipse.ui contributes — hence the washed-out colours and dead shortcuts.

  Select it in Preferences > Plug-in Development > Target Platform. Switching back to
  `targetplatform` before committing is not required, but do sanity-check a change
  against the lean target (or just run `mvn -f parent clean verify`) before pushing:
  with the SDK on the classpath the IDE will happily compile against bundles the real
  target platform does not contain.

  First resolve downloads the SDK (a few hundred MB) into the shared p2 bundle pool.
-->
<target name="DebugMemoryView - full IDE (launch only)" sequenceNumber="1">
  <locations>
    <!-- The whole Eclipse SDK product: Platform + JDT + PDE, with the IDE application,
         themes, intro/welcome, help, and the platform-specific launcher fragments.
         includeSource is off because the SDK already carries its own source bundles. -->
    <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
      <repository location="https://download.eclipse.org/releases/2026-06"/>
      <unit id="org.eclipse.sdk.ide" version="0.0.0"/>
      <!-- Not part of the SDK, but the plug-in's Require-Bundle needs it. -->
      <unit id="org.eclipse.draw2d" version="0.0.0"/>
      <!-- Import-Package: org.apache.commons.lang3 (Orbit, published in the train). -->
      <unit id="org.apache.commons.lang3" version="0.0.0"/>
      <!-- @NonNull/@Nullable annotations (org.eclipse.jdt.annotation), CLASS retention only. -->
      <unit id="org.eclipse.jdt.annotation" version="0.0.0"/>
      <!-- Add anything else you want in the runtime workbench here, e.g.
           <unit id="org.eclipse.egit.feature.group" version="0.0.0"/> -->
    </location>
    <!-- Same JUnit 5 set as the lean target, so the tests fragment still compiles in the
         IDE (its Import-Package is org.junit.jupiter.api). The release train does not
         publish JUnit. -->
    <location includeDependencyDepth="none" includeDependencyScopes="compile" label="JUnit 5" missingManifest="generate" type="Maven">
      <dependencies>
        <dependency>
          <groupId>org.apiguardian</groupId>
          <artifactId>apiguardian-api</artifactId>
          <version>1.1.2</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-api</artifactId>
          <version>5.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-engine</artifactId>
          <version>5.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.platform</groupId>
          <artifactId>junit-platform-commons</artifactId>
          <version>1.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.platform</groupId>
          <artifactId>junit-platform-engine</artifactId>
          <version>1.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.platform</groupId>
          <artifactId>junit-platform-launcher</artifactId>
          <version>1.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.platform</groupId>
          <artifactId>junit-platform-suite-api</artifactId>
          <version>1.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.platform</groupId>
          <artifactId>junit-platform-suite-commons</artifactId>
          <version>1.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.junit.platform</groupId>
          <artifactId>junit-platform-suite-engine</artifactId>
          <version>1.14.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>org.opentest4j</groupId>
          <artifactId>opentest4j</artifactId>
          <version>1.3.0</version>
          <type>jar</type>
        </dependency>
      </dependencies>
    </location>
  </locations>
</target>
